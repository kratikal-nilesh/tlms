{
  "name": "KRADEMY_LMS.COM",
  "version": "0.1.0",
  "description": "Analyse DMARC Records for a domain",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --watch src --exec babel-node --presets @babel/env src/index.js",
    "start2": "nodemon --exec ./scripts/nodemon_kill_and_restart.sh",
    "debug": "babel-node --presets @babel/env src/index.js",
    "build": "babel src -d dist --source-maps inline --copy-files",
    "serve": "node dist/index.js",
    "sequelize": "sequelize",
    "db:generate": "sh scripts/db/migrations/generate.sh",
    "db:undo": "npm run sequelize db:migrate:undo",
    "db:undo:name": "sh scripts/db/migrations/undo-one.sh",
    "db:seed:name": "sh scripts/db/migrations/seed-one.sh",
    "db:seed:generate": "sh scripts/db/migrations/generate-seed.sh",
    "db:migrate": "npm run sequelize db:migrate",
    "setup:mysql:install": "sh scripts/setup/mysql/install.sh",
    "setup:mysql:restart": "sh scripts/setup/mysql/restart.sh",
    "setup:mysql:dumpFile": "sh scripts/setup/mysql/getSqlDump.sh",
    "setup:redis:start": "sh scripts/setup/redis/start.sh",
    "setup:docker:install": "sh scripts/setup/docker/install.sh",
    "setup:nginx:install": "sh scripts/setup/nginx/install.sh",
    "setup:certificate:install": "sh scripts/setup/certificate/install.sh",
    "setup": "sh scripts/setup/setup.sh",
    "updateTemplates": "babel-node --presets @babel/env scripts/db/newTemplate/scriptIndex.js",
    "updateCategories": "babel-node --presets @babel/env scripts/db/migrateCategories/start.js",
    "createNewCompany": "babel-node --presets @babel/env scripts/db/createNewCompany.js",
    "addLanguageNameToContentVideos": "babel-node --presets @babel/env scripts/db/addLanguageToCode",
    "addEstimatedTimeToCourses": "babel-node --presets @babel/env scripts/db/addEstimatedTimeToCourses.js",
    "migrate:resultStatus": "babel-node --presets @babel/env scripts/db/addStatusToTracking.js",
    "migrate:umc": "babel-node --presets @babel/env scripts/db/updateMemberCourses.js",
    "migrate:umcq": "babel-node --presets @babel/env scripts/db/updateMemberCoursesQuiz.js",
    "migrate:avgCS": "babel-node --presets @babel/env scripts/db/addLeaderboardTrackableEntry.js",
    "createUpdateAllMembers": "babel-node --presets @babel/env scripts/db/createUpdateAllMembers.js",
    "insertCampaignMembersToGroups": "babel-node --presets @babel/env scripts/db/inputToGroupMembersForCampaign.js",
    "modify:category": "babel-node --presets @babel/env scripts/db/removeCategoryAndAddNotAssigned",
    "addIssueDate": "babel-node --presets @babel/env scripts/db/addCertificateNoAndIssueDate.js",
    "migrate:denormalize-table": "babel-node --presets @babel/env scripts/db/denormalizeContentAssistanceTables/index.js",
    "db-correction": "BROWSERSLIST_IGNORE_OLD_DATA=true babel-node --quiet --presets @babel/env --no-warnings scripts/db/correction",
    "createDummyData": "babel-node --presets @babel/env scripts/db/addSCLT/CreateDummyData.js",
    "fixCourseDuration": "babel-node --presets @babel/env scripts/db/fixDurationForBadClonedCourses.js",
    "test:db:query": "babel-node --presets @babel/env test/dbQuery.js",
    "test:index": "babel-node --presets @babel/env test/index.js",
    "test": "babel-node --presets @babel/env test/index.js",
    "test:jest": "jest --watchAll",
    "update:dao:constants": "babel-node --presets @babel/env scripts/misc/createDaoConstants.js",
    "fix:create-member-courses": "babel-node --presets @babel/env scripts/db/createMemberCoursesIfSessionIsCreated",
    "addOldSamlToNewSso": "babel-node --presets @babel/env scripts/db/addOldSamlToNewSso"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git-codecommit.ap-south-1.amazonaws.com/v1/repos/dmarc-report"
  },
